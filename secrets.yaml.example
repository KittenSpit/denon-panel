# Copy this to secrets.yaml (git-ignored) and fill in real values.
# Generate the API key: openssl rand -base64 32

wifi_ssid: "YOUR_WIFI"
wifi_password: "YOUR_WIFI_PASSWORD"

ap_password: "something_at_least_8_chars"   # fallback hotspot when Wi-Fi is down

api_encryption_key: "REPLACE_WITH_32_BYTE_BASE64_KEY"
ota_password: "REPLACE_WITH_ANYTHING_LONG"
